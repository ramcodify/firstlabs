# Security and DDoS / Abuse Prevention Headers for Cloudflare Pages & Netlify
/*
  # Prevent Clickjacking & Frame Injection
  X-Frame-Options: DENY
  
  # Prevent MIME Sniffing
  X-Content-Type-Options: nosniff
  
  # Restrict Referrer Information Leakage
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Disable unnecessary browser permissions/APIs
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  
  # Content Security Policy (CSP) against XSS & Unauthorized Script Execution
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:;
  
  # Caching controls for static assets to reduce server load during traffic surges
  Cache-Control: public, max-age=31536000, immutable
